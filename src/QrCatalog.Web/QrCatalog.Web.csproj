<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\QrCatalog.Infrastructure\QrCatalog.Infrastructure.csproj" />
    <ProjectReference Include="..\QrCatalog.Application\QrCatalog.Application.csproj" />
    <ProjectReference Include="..\QrCatalog.Domain\QrCatalog.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.20" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dev faylı produksiya image-inə DÜŞMƏSİN: içində lokal admin paroluna və
         localhost bağlantı sətrinə bənzər dəyərlər var. ASPNETCORE_ENVIRONMENT-də
         təsadüfi "Development" onları canlı serverdə aktivləşdirə bilərdi. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
