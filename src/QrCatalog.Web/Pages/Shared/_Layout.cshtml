<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — WOODMARK</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
    <meta name="theme-color" content="#173f32" />
    <meta name="description" content="Açıq hava məkanları üçün seçilmiş mebel kolleksiyası." />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="site-body"
      data-qr-token="@(ViewData["QrToken"] as string)">
    <a class="skip-link" href="#main-content">Məzmuna keç</a>

    <header class="site-header">
        <div class="site-shell site-header__inner">
            <a class="brand" href="/katalog" aria-label="WOODMARK kataloqu">
                @* Loqo şəkil kimi verilir (150px mənbədən 600px-ə hamarlanıb). Vektor
                   variant gələndə bunu SVG ilə əvəz etmək daha yaxşıdır: çap və iri
                   ekranlar üçün raster kifayət etmir. *@
                <img class="brand__logo" src="~/img/woodmark-brown.png" alt="" width="44" height="44" />
                <span class="brand__copy">
                    <strong>WOOD<span>MARK</span></strong>
                    <small>Taxta açıq hava mebeli</small>
                </span>
            </a>

            <nav class="site-nav" aria-label="Əsas naviqasiya">
                <a href="/katalog">Kolleksiya</a>
                <a class="site-nav__cta" href="/katalog#axtaris">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m21 21-4.35-4.35m1.35-5.15a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z" />
                    </svg>
                    Məhsul axtar
                </a>
            </nav>
        </div>
    </header>

    <main id="main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-shell site-footer__inner">
            <div>
                <p class="site-footer__brand">Təbiətdən ilhamlanan rahatlıq.</p>
                <p class="site-footer__note">Açıq hava məkanları üçün düşünülmüş kolleksiya.</p>
            </div>
            <a href="/katalog">Kolleksiyaya bax <span aria-hidden="true">↗</span></a>
        </div>
        @* İşçi skamyadaki QR-ı skan edib bu linkdən girir; giriş bitəndə HƏMİN səhifəyə
           qayıdır (qayit) və artıq girişli olduğu üçün admin ekranı açılır. Səhifə
           keşlənsə də problem yoxdur — link hər ziyarətçi üçün eyni yoldur. Qəsdən
           solğundur: müştəri üçün nəzərdə tutulmayıb. *@
        <div class="site-shell site-footer__meta">
            <a class="site-footer__staff"
               href="/admin/login?qayit=@(Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString))">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="4" y="10.5" width="16" height="10.5" rx="2.5" />
                    <path d="M8 10.5V7.2a4 4 0 0 1 8 0v3.3" />
                </svg>
                İşçi girişi
            </a>
        </div>
    </footer>

    <script src="~/js/public.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
