@model QrCatalog.Web.Pages.PublicProductVm

<article class="mx-auto max-w-2xl px-4 pb-24 pt-6">
    <nav aria-label="Yol" class="text-xs text-stone-400">
        <a href="/katalog" class="hover:text-emerald-800 hover:underline">Kataloq</a>
        <span aria-hidden="true"> › </span>
        <a href="/katalog/@Model.CategorySlug" class="hover:text-emerald-800 hover:underline">@Model.CategoryName</a>
    </nav>

    @if (Model.Images.Count > 0)
    {
        <div class="mt-4">
            <img id="main-image"
                 src="@Model.Images[0].MainUrl"
                 srcset="@Model.Images[0].Srcset"
                 sizes="(max-width: 672px) 100vw, 672px"
                 alt="@(Model.Images[0].Alt ?? Model.Name)"
                 class="aspect-[4/3] w-full rounded-xl bg-stone-100 object-cover" />

            @if (Model.Images.Count > 1)
            {
                <div class="mt-2 flex gap-2 overflow-x-auto pb-1">
                    @for (var i = 0; i < Model.Images.Count; i++)
                    {
                        var image = Model.Images[i];
                        <button type="button"
                                class="thumb h-16 w-16 flex-none overflow-hidden rounded-lg border-2 @(i == 0 ? "border-emerald-700" : "border-transparent")"
                                data-src="@image.MainUrl" data-srcset="@image.Srcset"
                                data-alt="@(image.Alt ?? Model.Name)"
                                aria-label="Şəkil @(i + 1)">
                            <img src="@image.ThumbUrl" alt="" loading="lazy"
                                 class="h-full w-full object-cover" />
                        </button>
                    }
                </div>
            }
        </div>
    }

    @if (Model.HumanCode is not null)
    {
        <p class="mt-5 font-mono text-xs tracking-wide text-stone-400">@Model.HumanCode</p>
    }
    <h1 class="mt-1 text-2xl font-semibold tracking-tight text-balance">@Model.Name</h1>

    @if (Model.Description is not null)
    {
        <p class="mt-3 leading-relaxed text-stone-600">@Model.Description</p>
    }

    @if (Model.Specs.Count > 0)
    {
        <h2 class="mt-8 text-sm font-semibold uppercase tracking-wide text-stone-400">
            Texniki göstəricilər
        </h2>
        <dl class="mt-2 divide-y divide-stone-100 rounded-xl border border-stone-200 bg-white">
            @foreach (var spec in Model.Specs)
            {
                <div class="flex justify-between gap-4 px-4 py-2.5 text-sm">
                    <dt class="text-stone-500">@spec.Label</dt>
                    <dd class="text-right font-medium">@spec.Value</dd>
                </div>
            }
        </dl>
    }

    <details class="mt-6 rounded-xl border border-stone-200 bg-white">
        <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-stone-700">
            Sorğu göndərin — sizinlə əlaqə saxlayaq
        </summary>
        @* Forma QƏSDƏN method/action daşımır: göndərmə public.js-dən fetch ilə JSON kimi
           gedir (public endpoint honeypot + rate limit ilə qorunur). Buraya method="post"
           əlavə etmək Razor-un antiforgery tokenini və COOKIE-sini gətirir; Set-Cookie
           daşıyan cavabı isə output cache SAXLAMIR — skanın düşdüyü əsas səhifə keşsiz
           qalar. PublicSiteTests bunu yoxlayır (6a/6b bəndləri). *@
        <form id="inquiry-form" class="border-t border-stone-100 px-4 py-4">
            <input type="hidden" name="productSlug" value="@Model.Slug" />
            <input type="hidden" name="qrToken" value="@Model.QrToken" />
            @* Honeypot — insanlar görmür, botlar doldurur *@
            <input type="text" name="website" tabindex="-1" autocomplete="off"
                   class="absolute -left-[9999px] h-0 w-0 opacity-0" aria-hidden="true" />

            <label class="block">
                <span class="text-sm font-medium text-stone-700">Adınız</span>
                <input name="name" required maxlength="200"
                       class="mt-1 w-full rounded border border-stone-300 px-3 py-2 text-sm outline-none focus:border-emerald-700" />
            </label>
            <label class="mt-3 block">
                <span class="text-sm font-medium text-stone-700">Telefon</span>
                <input name="phone" type="tel" required maxlength="30" placeholder="+994 50 123 45 67"
                       class="mt-1 w-full rounded border border-stone-300 px-3 py-2 text-sm outline-none focus:border-emerald-700" />
            </label>
            <label class="mt-3 block">
                <span class="text-sm font-medium text-stone-700">Mesaj (istəyə görə)</span>
                <textarea name="message" rows="2" maxlength="4000"
                          class="mt-1 w-full rounded border border-stone-300 px-3 py-2 text-sm outline-none focus:border-emerald-700"></textarea>
            </label>

            <p id="inquiry-error" role="alert" hidden
               class="mt-3 rounded bg-red-50 px-3 py-2 text-sm text-red-800"></p>

            <button type="submit"
                    class="mt-4 w-full rounded-lg border border-emerald-800 px-4 py-2.5 text-sm font-semibold text-emerald-900 hover:bg-emerald-50">
                Göndər
            </button>
        </form>
        <p id="inquiry-done" hidden class="border-t border-stone-100 px-4 py-4 text-sm text-emerald-800">
            Sorğunuz qəbul olundu — tezliklə sizinlə əlaqə saxlayacağıq. ✓
        </p>
    </details>

    @if (Model.WhatsappUrl is not null || Model.Phone is not null)
    {
        <div class="fixed inset-x-0 bottom-0 border-t border-stone-200 bg-white/95 p-3 backdrop-blur">
            <div class="mx-auto flex max-w-2xl gap-2">
                @if (Model.WhatsappUrl is not null)
                {
                    <a href="@Model.WhatsappUrl"
                       class="flex-1 rounded-lg bg-emerald-800 px-4 py-3 text-center text-sm font-semibold text-white hover:bg-emerald-700">
                        Qiymət və sifariş — WhatsApp
                    </a>
                }
                @if (Model.Phone is not null)
                {
                    <a href="tel:@Model.Phone"
                       class="rounded-lg border border-emerald-800 px-4 py-3 text-sm font-semibold text-emerald-900 hover:bg-emerald-50">
                        Zəng et
                    </a>
                }
            </div>
        </div>
    }
</article>

@* Qalereya, sorğu forması və beacon məntiqi wwwroot/js/public.js-dədir — CSP script-src 'self' *@

