@model QrCatalog.Web.Pages.PublicProductVm

<article class="product-page">
    <div class="site-shell">
        <nav aria-label="Yol" class="breadcrumb reveal">
            <a href="/katalog">Kataloq</a>
            <span class="breadcrumb__divider" aria-hidden="true">/</span>
            <a href="/katalog/@Model.CategorySlug">@Model.CategoryName</a>
            <span class="breadcrumb__divider" aria-hidden="true">/</span>
            <span aria-current="page">@Model.Name</span>
        </nav>

        <div class="product-layout">
            <section class="product-gallery reveal" aria-label="Məhsul şəkilləri">
                @if (Model.Images.Count > 0)
                {
                    <div class="product-gallery__stage">
                        <img id="main-image"
                             src="@Model.Images[0].MainUrl"
                             srcset="@Model.Images[0].Srcset"
                             sizes="(max-width: 900px) 100vw, 720px"
                             alt="@(Model.Images[0].Alt ?? Model.Name)" />
                        <span class="product-gallery__label">Natural collection</span>
                        <span class="product-gallery__count">01 / @Model.Images.Count.ToString("00")</span>
                    </div>

                    @if (Model.Images.Count > 1)
                    {
                        <div class="product-gallery__thumbs" aria-label="Digər şəkillər">
                            @for (var i = 0; i < Model.Images.Count; i++)
                            {
                                var image = Model.Images[i];
                                <button type="button"
                                        class="thumb @(i == 0 ? "is-active" : "")"
                                        data-src="@image.MainUrl" data-srcset="@image.Srcset"
                                        data-alt="@(image.Alt ?? Model.Name)"
                                        data-index="@((i + 1).ToString("00"))"
                                        aria-label="Şəkil @(i + 1)"
                                        aria-pressed="@(i == 0 ? "true" : "false")">
                                    <img src="@image.ThumbUrl" alt="" loading="lazy" />
                                </button>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="product-gallery__stage product-gallery__placeholder">
                        <svg viewBox="0 0 160 160" fill="none" aria-hidden="true">
                            <path d="M31 122c36-5 72-33 99-81M45 98c-1-24 11-41 33-52 4 24-6 42-33 52Zm30 3c13-20 31-28 54-24-11 23-29 31-54 24Z" />
                        </svg>
                        <p>Şəkil hazırlanır</p>
                    </div>
                }
            </section>

            <section class="product-info reveal">
                <div class="product-info__meta">
                    <a href="/katalog/@Model.CategorySlug">@Model.CategoryName</a>
                    @if (Model.HumanCode is not null)
                    {
                        <span>@Model.HumanCode</span>
                    }
                </div>

                <h1>@Model.Name</h1>

                @if (Model.Description is not null)
                {
                    <p class="product-info__description">@Model.Description</p>
                }

                <div class="product-promises">
                    <div>
                        <svg viewBox="0 0 32 32" aria-hidden="true">
                            <path d="M16 27V10m0 9c-5-1-8-4-9-9 5 0 8 3 9 9Zm0-4c4-1 7-4 8-9-5 0-8 3-8 9Z" />
                        </svg>
                        <span><strong>Təbii görünüş</strong>Materialın öz xarakteri</span>
                    </div>
                    <div>
                        <svg viewBox="0 0 32 32" aria-hidden="true">
                            <path d="M7 22h18M9 22v4m14-4v4M10 22l2-11h8l2 11M13 11V7h6v4" />
                        </svg>
                        <span><strong>Açıq hava üçün</strong>Rahat və funksional</span>
                    </div>
                </div>

                @if (Model.Specs.Count > 0)
                {
                    <section class="specs-panel">
                        <div class="specs-panel__heading">
                            <p class="eyebrow"><span></span> Məhsul detalları</p>
                            <h2>Texniki göstəricilər</h2>
                        </div>
                        <dl>
                            @foreach (var spec in Model.Specs)
                            {
                                <div>
                                    <dt>@spec.Label</dt>
                                    <dd>@spec.Value</dd>
                                </div>
                            }
                        </dl>
                    </section>
                }

                <details class="inquiry-panel">
                    <summary>
                        <span>
                            <small>Qərar verməyə kömək edək</small>
                            Sorğu göndərin — sizinlə əlaqə saxlayaq
                        </span>
                        <i aria-hidden="true">+</i>
                    </summary>
                    @* Forma QƏSDƏN method/action daşımır: göndərmə public.js-dən fetch ilə JSON kimi
                       gedir (public endpoint honeypot + rate limit ilə qorunur). Buraya method="post"
                       əlavə etmək Razor-un antiforgery tokenini və COOKIE-sini gətirir; Set-Cookie
                       daşıyan cavabı isə output cache SAXLAMIR — skanın düşdüyü əsas səhifə keşsiz
                       qalar. PublicSiteTests bunu yoxlayır (6a/6b bəndləri). *@
                    <form id="inquiry-form">
                        <input type="hidden" name="productSlug" value="@Model.Slug" />
                        <input type="hidden" name="qrToken" value="@Model.QrToken" />
                        <input type="text" name="website" tabindex="-1" autocomplete="off"
                               class="honeypot" aria-hidden="true" />

                        <div class="form-grid">
                            <label>
                                <span>Adınız</span>
                                <input name="name" required maxlength="200" placeholder="Ad və soyad" />
                            </label>
                            <label>
                                <span>Telefon</span>
                                <input name="phone" type="tel" required maxlength="30" placeholder="+994 50 123 45 67" />
                            </label>
                        </div>
                        <label>
                            <span>Mesaj <small>istəyə görə</small></span>
                            <textarea name="message" rows="3" maxlength="4000"
                                      placeholder="Məhsul haqqında nə bilmək istərdiniz?"></textarea>
                        </label>

                        <p id="inquiry-error" role="alert" hidden class="form-message form-message--error"></p>

                        <button type="submit" class="button button--primary button--wide">
                            Göndər <span aria-hidden="true">↗</span>
                        </button>
                    </form>
                    <div id="inquiry-done" hidden class="form-message form-message--success">
                        <span aria-hidden="true">✓</span>
                        <div>
                            <strong>Sorğunuz qəbul olundu</strong>
                            <p>Tezliklə sizinlə əlaqə saxlayacağıq.</p>
                        </div>
                    </div>
                </details>
            </section>
        </div>
    </div>

    @if (Model.WhatsappUrl is not null || Model.Phone is not null)
    {
        <div class="contact-dock">
            <div class="site-shell contact-dock__inner">
                <div class="contact-dock__copy">
                    <span>Bu modeli bəyəndiniz?</span>
                    <strong>Qiymət və mövcudluğu indi soruşun.</strong>
                </div>
                <div class="contact-dock__actions">
                    @if (Model.Phone is not null)
                    {
                        <a href="tel:@Model.Phone" class="contact-dock__phone">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M7.5 3.5 10 8 8.5 9.5c1.1 2.2 2.8 3.9 5 5L15 13l4.5 2.5-1 4c-.2.8-.9 1.3-1.7 1.2C9.8 19.9 4.1 14.2 3.3 7.2c-.1-.8.4-1.5 1.2-1.7l3-2Z" />
                            </svg>
                            Zəng et
                        </a>
                    }
                    @if (Model.WhatsappUrl is not null)
                    {
                        <a href="@Model.WhatsappUrl" class="button button--primary">
                            WhatsApp ilə qiymət soruş <span aria-hidden="true">↗</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</article>

@* Qalereya, sorğu forması və beacon məntiqi wwwroot/js/public.js-dədir — CSP script-src 'self' *@
