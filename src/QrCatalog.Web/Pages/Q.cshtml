@page "/q/{token}"
@model QrCatalog.Web.Pages.QModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["QrToken"] = Model.Token;
}

@if (Model.State == QrCatalog.Web.Pages.QState.Found && Model.Product is not null)
{
    <partial name="_ProductView" model="Model.Product" />
}
else
{
    <section class="status-section">
        <div class="status-card reveal">
            <div class="status-card__mark" aria-hidden="true">
                @(Model.State == QrCatalog.Web.Pages.QState.Retired ? "×" : "!")
            </div>
            @if (Model.HumanCode is not null)
            {
                <p class="status-card__code">@Model.HumanCode</p>
            }

            @if (Model.State == QrCatalog.Web.Pages.QState.Retired)
            {
                <p class="eyebrow"><span></span> Məlumat yenilənib</p>
                <h1>Bu kod artıq istifadədə deyil</h1>
                <p>Məhsul haqqında ən son məlumat üçün satıcı ilə əlaqə saxlayın.</p>
            }
            else if (Model.State == QrCatalog.Web.Pages.QState.Archived)
            {
                <p class="eyebrow"><span></span> Arxiv kolleksiyası</p>
                <h1>Bu model artıq istehsal olunmur</h1>
                <p>Yeni kolleksiyadan oxşar modellərə baxın və sizə uyğun seçimi tapın.</p>
            }
            else
            {
                <p class="eyebrow"><span></span> Kod tanınmadı</p>
                <h1>Kod tapılmadı</h1>
                <p>QR kodu yenidən skan edin və ya ünvanın düzgün olduğuna əmin olun.</p>
            }

            <a class="button button--primary" href="/katalog">
                Kolleksiyaya bax <span aria-hidden="true">↗</span>
            </a>
        </div>

        @if (Model.Similar.Count > 0)
        {
            <div class="site-shell similar-section">
                <div class="section-heading reveal">
                    <div>
                        <p class="eyebrow"><span></span> Sizin üçün seçdik</p>
                        <h2>Oxşar modellər</h2>
                    </div>
                </div>
                <div class="product-grid product-grid--similar">
                    @foreach (var card in Model.Similar)
                    {
                        <partial name="_ProductCard" model="card" />
                    }
                </div>
            </div>
        }
    </section>
}
