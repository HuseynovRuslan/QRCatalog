@page "/q/{token}"
@model QrCatalog.Web.Pages.QModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["QrToken"] = Model.Token; // public.js beacon-u body data-atributundan oxuyur
}

@if (Model.State == QrCatalog.Web.Pages.QState.Found && Model.Product is not null)
{
    <partial name="_ProductView" model="Model.Product" />
}
else
{
    <div class="flex min-h-screen flex-col items-center justify-center px-4">
        <div class="w-full max-w-md text-center">
            @if (Model.HumanCode is not null)
            {
                <p class="font-mono text-xs tracking-wide text-stone-400">@Model.HumanCode</p>
            }

            @if (Model.State == QrCatalog.Web.Pages.QState.Retired)
            {
                <h1 class="mt-2 text-2xl font-semibold tracking-tight">Bu kod artıq istifadədə deyil</h1>
                <p class="mt-3 text-stone-600">Məhsul haqqında məlumat üçün satıcı ilə əlaqə saxlayın.</p>
            }
            else if (Model.State == QrCatalog.Web.Pages.QState.Archived)
            {
                <h1 class="mt-2 text-2xl font-semibold tracking-tight">Bu model artıq istehsal olunmur</h1>
                <p class="mt-3 text-stone-600">Oxşar modellərə baxın və ya satıcı ilə əlaqə saxlayın.</p>
            }
            else
            {
                <h1 class="mt-2 text-2xl font-semibold tracking-tight">Kod tapılmadı</h1>
                <p class="mt-3 text-stone-600">
                    Bu QR kod sistemdə qeydiyyatda deyil. Ünvanı yoxlayın və ya satıcı ilə əlaqə saxlayın.
                </p>
            }
        </div>

        @if (Model.Similar.Count > 0)
        {
            <div class="mt-10 w-full max-w-2xl">
                <h2 class="text-sm font-semibold uppercase tracking-wide text-stone-400">Oxşar modellər</h2>
                <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
                    @foreach (var card in Model.Similar)
                    {
                        <partial name="_ProductCard" model="card" />
                    }
                </div>
            </div>
        }
    </div>
}
