@page "/katalog"
@model QrCatalog.Web.Pages.Catalog.IndexModel
@{
    ViewData["Title"] = "Kataloq";
}

@if (!Model.CatalogAvailable)
{
    <div class="flex min-h-screen items-center justify-center px-4 text-center">
        <p class="text-stone-500">Kataloq hazırlanır.</p>
    </div>
}
else
{
    <div class="mx-auto max-w-4xl px-4 py-6">
        <h1 class="text-2xl font-semibold tracking-tight">Kataloq</h1>

        <form method="get" class="mt-4">
            <input type="search" name="axtar" value="@Model.Search"
                   placeholder="Məhsul axtar…"
                   class="w-full max-w-md rounded-lg border border-stone-300 px-4 py-2.5 text-sm outline-none focus:border-emerald-700 focus:ring-2 focus:ring-emerald-700/20" />
        </form>

        @if (string.IsNullOrWhiteSpace(Model.Search) && Model.Categories.Count > 0)
        {
            <div class="mt-6 flex flex-wrap gap-2">
                @foreach (var category in Model.Categories)
                {
                    <a href="/katalog/@category.Slug"
                       class="rounded-full border border-stone-200 bg-white px-4 py-1.5 text-sm hover:border-emerald-700/40">
                        @category.Name
                        <span class="text-stone-400">@category.ProductCount</span>
                    </a>
                }
            </div>
        }

        @if (Model.Products.Count == 0)
        {
            <p class="mt-10 text-center text-sm text-stone-400">
                @(string.IsNullOrWhiteSpace(Model.Search)
                    ? "Hələ məhsul yoxdur."
                    : $"\"{Model.Search}\" üzrə nəticə tapılmadı.")
            </p>
        }
        else
        {
            <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
                @foreach (var card in Model.Products)
                {
                    <partial name="_ProductCard" model="card" />
                }
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-8 flex items-center justify-center gap-3 text-sm" aria-label="Səhifələr">
                @if (Model.CurrentPage > 1)
                {
                    <a href="?seh=@(Model.CurrentPage - 1)&axtar=@Model.Search"
                       class="rounded border border-stone-300 px-3 py-1.5 hover:bg-stone-50">‹ Əvvəlki</a>
                }
                <span class="tabular-nums text-stone-500">@Model.CurrentPage / @Model.TotalPages</span>
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="?seh=@(Model.CurrentPage + 1)&axtar=@Model.Search"
                       class="rounded border border-stone-300 px-3 py-1.5 hover:bg-stone-50">Növbəti ›</a>
                }
            </nav>
        }
    </div>
}
