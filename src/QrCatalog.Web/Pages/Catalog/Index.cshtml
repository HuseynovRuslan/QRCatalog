@page "/katalog"
@model QrCatalog.Web.Pages.Catalog.IndexModel
@{
    ViewData["Title"] = "Kataloq";
}

@if (!Model.CatalogAvailable)
{
    <section class="state-page">
        <div class="state-page__icon" aria-hidden="true">✦</div>
        <p class="eyebrow"><span></span> Tezliklə</p>
        <h1>Kolleksiya hazırlanır.</h1>
        <p>Seçilmiş məhsulları sizin üçün bir araya gətiririk.</p>
    </section>
}
else
{
    <section class="catalog-hero">
        <div class="catalog-hero__grain" aria-hidden="true"></div>
        <div class="site-shell catalog-hero__inner">
            <div class="catalog-hero__copy reveal">
                <p class="eyebrow eyebrow--light"><span></span> Açıq hava kolleksiyası</p>
                <h1>Rahatlıq<br /><em>təbiətə</em> qovuşur.</h1>
                <p>Bağınızı, terrasınızı və balkonunuzu yaşamaq istədiyiniz məkana çevirən seçilmiş modellər.</p>
            </div>
            <div class="catalog-hero__meta reveal">
                <strong>@Model.Total</strong>
                <span>seçilmiş<br />məhsul</span>
            </div>
        </div>

        <form method="get" id="axtaris" class="site-shell catalog-search reveal">
            <label for="catalog-search-input">Kolleksiyada axtar</label>
            <div class="catalog-search__field">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m21 21-4.35-4.35m1.35-5.15a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z" />
                </svg>
                <input id="catalog-search-input" type="search" name="axtar" value="@Model.Search"
                       placeholder="Məsələn: şezlonq, yelləncək, masa…" />
                <button type="submit">Axtar <span aria-hidden="true">↗</span></button>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <div class="catalog-search__active">
                    <span>“@Model.Search” üçün nəticələr</span>
                    <a href="/katalog">Axtarışı təmizlə ×</a>
                </div>
            }
        </form>
    </section>

    <section class="catalog-main">
        <div class="site-shell">
            @if (string.IsNullOrWhiteSpace(Model.Search) && Model.Categories.Count > 0)
            {
                <div class="section-heading reveal">
                    <div>
                        <p class="eyebrow"><span></span> Məkanına görə seç</p>
                        <h2>Kateqoriyalar</h2>
                    </div>
                    <p>Hər açıq hava anı üçün düşünülmüş seçimlər.</p>
                </div>
                <div class="category-grid">
                    @foreach (var category in Model.Categories)
                    {
                        <a href="/katalog/@category.Slug" class="category-card reveal">
                            <span class="category-card__number">@category.ProductCount.ToString("00")</span>
                            <div>
                                <h3>@category.Name</h3>
                                <p>@(category.Description ?? "Kolleksiyanı kəşf edin")</p>
                            </div>
                            <span class="category-card__arrow" aria-hidden="true">↗</span>
                        </a>
                    }
                </div>
            }

            <div class="section-heading section-heading--products reveal">
                <div>
                    <p class="eyebrow"><span></span> Seçilmiş dizaynlar</p>
                    <h2>@(string.IsNullOrWhiteSpace(Model.Search) ? "Bütün məhsullar" : "Axtarış nəticələri")</h2>
                </div>
                <p>@Model.Total məhsul</p>
            </div>

            @if (Model.Products.Count == 0)
            {
                <div class="empty-state reveal">
                    <span aria-hidden="true">⌕</span>
                    <h2>Nəticə tapılmadı</h2>
                    <p>
                        @(string.IsNullOrWhiteSpace(Model.Search)
                            ? "Kolleksiyaya yeni məhsullar əlavə olunur."
                            : $"“{Model.Search}” üçün uyğun məhsul yoxdur. Başqa sözlə axtarmağı sınayın.")
                    </p>
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <a class="button button--outline" href="/katalog">Bütün məhsullara bax</a>
                    }
                </div>
            }
            else
            {
                <div class="product-grid">
                    @foreach (var card in Model.Products)
                    {
                        <partial name="_ProductCard" model="card" />
                    }
                </div>
            }

            @if (Model.TotalPages > 1)
            {
                <nav class="pagination" aria-label="Səhifələr">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="?seh=@(Model.CurrentPage - 1)&axtar=@Model.Search">← Əvvəlki</a>
                    }
                    else
                    {
                        <span></span>
                    }
                    <span class="pagination__count">@Model.CurrentPage <i>/</i> @Model.TotalPages</span>
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="?seh=@(Model.CurrentPage + 1)&axtar=@Model.Search">Növbəti →</a>
                    }
                    else
                    {
                        <span></span>
                    }
                </nav>
            }
        </div>
    </section>
}
