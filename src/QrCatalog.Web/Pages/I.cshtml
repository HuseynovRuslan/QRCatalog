@page "/i/{token}"
@model QrCatalog.Web.Pages.IModel
@{
    ViewData["Title"] = Model.Title;
    Layout = null; // müştəri layout-u deyil: bu daxili ekrandır
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title — WOODMARK</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
    <meta name="theme-color" content="#173f32" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="staff-body">
    <header class="staff-top">
        <a class="staff-top__brand" href="/admin/">
            <img src="~/img/woodmark-cream.png" alt="" width="30" height="30" />
            <span>WOODMARK</span>
        </a>
        <span class="staff-top__tag">DAXİLİ MƏLUMAT</span>
    </header>

    <main class="staff-wrap">
        @* Ölü etiket: müştəri bu kodu skan edəndə boş səhifə görür, tapıb dəyişməli
           olan yeganə adam isə işçidir — xəbərdarlıq ondan gizlədilməməlidir. *@
        @if (Model.Retired)
        {
            <p class="staff-alert">
                <strong>Bu etiket istifadədən çıxarılıb.</strong>
                Sökülüb yenisi ilə əvəz olunmalıdır — müştəri bu kodu skan edəndə
                məhsulu görmür.
            </p>
        }

        @if (Model.Unit is { } u)
        {
            @* ── NÜSXƏ EKRANI: əvvəl KİMLİK, sonra YER, sonra rəqəmlər ── *@
            <section class="staff-unit-head">
                @if (u.ImageUrl is not null)
                {
                    <img class="staff-unit-head__img" src="@u.ImageUrl" alt=""
                         width="64" height="64" loading="lazy" />
                }
                <div>
                    <p class="staff-unit-head__code">@u.UnitCode</p>
                    <h1>@u.ProductName</h1>
                    <span class="staff-status staff-status--@u.Status.ToString().ToLowerInvariant()">
                        @u.StatusLabel
                    </span>
                </div>
            </section>

            <section class="staff-where">
                <h2>Haradadır</h2>
                @if (u.Site is { } site)
                {
                    <p class="staff-where__name">@site.Name</p>
                    <p class="staff-where__meta">
                        @site.Kind@(site.Address is null ? "" : " · " + site.Address)
                    </p>

                    <p class="staff-where__coords">
                        @site.Latitude.ToString("0.00000", System.Globalization.CultureInfo.InvariantCulture),
                        @site.Longitude.ToString("0.00000", System.Globalization.CultureInfo.InvariantCulture)
                        <span>@(site.ExactPosition ? "nüsxənin öz mövqeyi" : "təxmini — obyektin ümumi nöqtəsi")</span>
                    </p>

                    var lat = site.Latitude.ToString("0.000000", System.Globalization.CultureInfo.InvariantCulture);
                    var lon = site.Longitude.ToString("0.000000", System.Globalization.CultureInfo.InvariantCulture);

                    @* Universal xəritə linki: telefonda quraşdırılmış tətbiqi açır,
                       yoxdursa brauzerdə göstərir. Waze/Yandex ayrıca verilir —
                       Azərbaycanda hər ikisi geniş işlədilir. *@
                    <a class="staff-btn staff-btn--wide"
                       href="https://www.google.com/maps/dir/?api=1&destination=@lat,@lon"
                       target="_blank" rel="noopener">Yol göstər</a>
                    <p class="staff-maplinks">
                        <a href="https://waze.com/ul?ll=@lat,@lon&navigate=yes" target="_blank" rel="noopener">Waze</a>
                        <span>·</span>
                        <a href="https://yandex.com/maps/?rtext=~@lat,@lon&rtt=auto" target="_blank" rel="noopener">Yandex</a>
                    </p>

                    <div class="staff-here">
                        <button type="button" class="staff-here__btn" data-here
                                data-lat="@lat" data-lon="@lon">Buradayam? Məsafəni yoxla</button>
                        <p class="staff-here__out" data-here-result></p>
                    </div>
                }
                else
                {
                    <p class="staff-empty">
                        Bu nüsxə heç bir obyektə təyin edilməyib — qeyddə anbarda görünür.
                    </p>
                }
            </section>

            <section class="staff-facts">
                <dl>
                    @if (u.InstalledOn is { } installed)
                    {
                        <div>
                            <dt>Quraşdırılıb</dt>
                            <dd>@installed.ToString("dd.MM.yyyy")@(u.Age is null ? "" : $" · {u.Age}")</dd>
                        </div>
                    }
                    @if (u.Warranty is { } warranty)
                    {
                        <div class="@(warranty.Expired ? "is-expired" : "")">
                            <dt>Zəmanət</dt>
                            <dd>@warranty.Text</dd>
                        </div>
                    }
                    @if (u.Sku is not null)
                    {
                        <div>
                            <dt>Model kodu</dt>
                            <dd>@u.Sku</dd>
                        </div>
                    }
                </dl>
                @if (u.Note is not null)
                {
                    <p class="staff-note staff-note--boxed">@u.Note</p>
                }
            </section>

            @if (u.Site?.ContactPhone is { } phone)
            {
                <section class="staff-contact">
                    <div>
                        <span>Obyektin əlaqə şəxsi</span>
                        <strong>@(u.Site.ContactName ?? u.Site.Name)</strong>
                    </div>
                    <a class="staff-btn staff-btn--call" href="tel:@phone">@phone</a>
                </section>
            }

            @* ── Bir toxunuş arxasında: saylar, digər nüsxələr, obyektin qalanı ── *@
            <section class="staff-more">
                <details>
                    <summary>Bu modeldən neçə ədədimiz var<span>@u.Total</span></summary>
                    <dl class="staff-more__grid">
                        <div><dt>Quraşdırılıb</dt><dd>@u.Installed</dd></div>
                        <div><dt>Anbarda</dt><dd>@u.InStock</dd></div>
                        <div><dt>Təmirdə</dt><dd>@u.InRepair</dd></div>
                    </dl>
                    <p class="staff-hint">Çıxarılmış nüsxələr bu cəmə daxil deyil.</p>
                </details>

                @if (u.SameSiteCodes.Count > 0)
                {
                    <details>
                        <summary>Bu obyektdə eyni modeldən<span>@u.SameSiteCodes.Count</span></summary>
                        <p class="staff-codes">@string.Join(" · ", u.SameSiteCodes)</p>
                    </details>
                }

                @if (u.SiteOtherProducts.Count > 0)
                {
                    <details>
                        <summary>Bu obyektdə digər modellərimiz<span>@u.SiteOtherProducts.Count</span></summary>
                        <ul class="staff-minilist">
                            @foreach (var other in u.SiteOtherProducts)
                            {
                                <li><span>@other.Name</span><b>@other.Count əd.</b></li>
                            }
                        </ul>
                    </details>
                }

                <details>
                    <summary>Etiket<span>@Model.HumanCode</span></summary>
                    <p class="staff-hint">
                        Bu etiket konkret nüsxəyə bağlıdır — skan edən işçi məhz bu
                        nüsxəni görür, müştəri isə modelin kataloq səhifəsini.
                    </p>
                </details>
            </section>

            <nav class="staff-actions">
                <a class="staff-btn staff-btn--ghost" href="/admin/vahidler?mehsul=@u.ProductId">
                    Bütün nüsxələr
                </a>
                @if (Model.CanEdit)
                {
                    <a class="staff-btn" href="/admin/mehsullar/@u.ProductId">Redaktə et</a>
                }
            </nav>

            <script src="~/js/staff.js" asp-append-version="true" defer></script>
        }
        else if (Model.Product is { } p)
        {
            @* ── MODEL EKRANI: etiket modelə bağlıdır, konkret nüsxə bilinmir ── *@
            <section class="staff-head">
                @if (p.ImageUrl is not null)
                {
                    <img class="staff-head__img" src="@p.ImageUrl" alt="" width="96" height="96" loading="lazy" />
                }
                <div class="staff-head__copy">
                    <span class="staff-eyebrow">@(p.CategoryName ?? "Kateqoriyasız")</span>
                    <h1>@p.Name</h1>
                    <div class="staff-chips">
                        @if (p.Sku is not null)
                        {
                            <span class="staff-chip staff-chip--mono">@p.Sku</span>
                        }
                        @if (Model.HumanCode is not null)
                        {
                            <span class="staff-chip staff-chip--mono">@Model.HumanCode</span>
                        }
                        <span class="staff-chip @(p.Published ? "staff-chip--ok" : "staff-chip--warn")">
                            @(p.Published ? "Kataloqda dərc olunub" : "Kataloqda görünmür")
                        </span>
                    </div>
                </div>
            </section>

            @* Dürüstlük: model etiketi hansı nüsxənin yanında dayandığını BİLMİR.
               Bunu yazmasaq işçi ekranın cavab verə bilmədiyi sualı ona verməyə davam edər. *@
            <p class="staff-note staff-note--boxed">
                Bu etiket <strong>modelə</strong> bağlıdır — hansı nüsxənin yanında
                olduğunuzu göstərə bilmir. Konkret skamyanı tanımaq üçün nüsxə
                etiketi lazımdır (hər nüsxənin öz kodu: @(p.Sku ?? "SK-…")/001).
            </p>

            <section class="staff-count">
                <div class="staff-count__main">
                    <strong>@p.Total</strong>
                    <span>ədəd — işlək</span>
                </div>
                <dl class="staff-count__split">
                    <div><dt>Quraşdırılıb</dt><dd>@p.Installed</dd></div>
                    <div><dt>Anbarda</dt><dd>@p.InStock</dd></div>
                    <div><dt>Təmirdə</dt><dd>@p.InRepair</dd></div>
                    @if (p.Removed > 0)
                    {
                        <div class="is-muted"><dt>Çıxarılıb</dt><dd>@p.Removed</dd></div>
                    }
                </dl>
            </section>

            <section class="staff-block">
                <h2>Hara quraşdırmışıq</h2>
                @if (p.Sites.Count == 0)
                {
                    <p class="staff-empty">
                        Bu modeldən heç bir obyektə quraşdırılmayıb — nüsxələr anbardadır
                        ya da hələ qeydə alınmayıb.
                    </p>
                }
                else
                {
                    @* Başlıq siyahının ÖZÜNDƏN hesablanır: obyektsiz «quraşdırılıb»
                       nüsxə varsa rəqəm yuxarıdakı sayla fərqlənir və bu, ekranın
                       öz-özünü təkzib etməsinin qarşısını alır. *@
                    <p class="staff-note">
                        @p.Sites.Count obyektdə, cəmi @p.Sites.Sum(x => x.Count) ədəd
                        @if (p.Sites.Sum(x => x.Count) != p.Installed)
                        {
                            <span class="staff-hint">
                                Qalan @(p.Installed - p.Sites.Sum(x => x.Count)) ədəd
                                «quraşdırılıb» kimi qeyd olunub, amma obyekti seçilməyib.
                            </span>
                        }
                    </p>
                    <ul class="staff-sites">
                        @foreach (var site in p.Sites)
                        {
                            <li>
                                <div class="staff-site__row">
                                    <span class="staff-site__name">@site.Name</span>
                                    <span class="staff-site__count">@site.Count əd.</span>
                                </div>
                                <div class="staff-site__meta">
                                    <span>@site.Kind</span>
                                    @if (site.Address is not null)
                                    {
                                        <span>· @site.Address</span>
                                    }
                                    @if (site.LastInstalledOn is { } installed)
                                    {
                                        <span>· quraşdırılıb: @installed.ToString("dd.MM.yyyy")</span>
                                    }
                                </div>
                                <details class="staff-site__codes">
                                    <summary>Nüsxə kodları (@site.UnitCodes.Count)</summary>
                                    <p>@string.Join(" · ", site.UnitCodes)</p>
                                </details>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="staff-block">
                <h2>Müştəri marağı</h2>
                <p class="staff-note">
                    Son 30 gündə bu modelin etiketləri <strong>@p.Scans30d dəfə</strong> skan olunub.
                    <span class="staff-hint">Öz işçilərimizin skanları bu saya düşmür.</span>
                </p>
            </section>

            <nav class="staff-actions">
                <a class="staff-btn staff-btn--ghost" href="/admin/vahidler?mehsul=@p.Id">
                    Xəritədə göstər
                </a>
                @if (Model.CanEdit)
                {
                    <a class="staff-btn" href="/admin/mehsullar/@p.Id">Redaktə et</a>
                }
            </nav>
        }
        else if (Model.Category is { } c)
        {
            <section class="staff-head">
                <div class="staff-head__copy">
                    <span class="staff-eyebrow">KATEQORİYA</span>
                    <h1>@c.Name</h1>
                    @if (Model.HumanCode is not null)
                    {
                        <div class="staff-chips">
                            <span class="staff-chip staff-chip--mono">@Model.HumanCode</span>
                        </div>
                    }
                </div>
            </section>

            <section class="staff-block">
                <h2>Bu kateqoriyadaki modellər</h2>
                @if (c.Products.Count == 0)
                {
                    <p class="staff-empty">Bu kateqoriyada hələ model yoxdur.</p>
                }
                else
                {
                    <ul class="staff-sites">
                        @foreach (var product in c.Products)
                        {
                            <li>
                                <div class="staff-site__row">
                                    <a class="staff-site__name" href="/admin/mehsullar/@product.Id">@product.Name</a>
                                    <span class="staff-site__count">@product.InstalledCount əd.</span>
                                </div>
                                <div class="staff-site__meta">
                                    @if (product.Sku is not null)
                                    {
                                        <span>@product.Sku · </span>
                                    }
                                    <span>@product.SiteCount obyektdə</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>

            <nav class="staff-actions">
                <a class="staff-btn staff-btn--ghost" href="/admin/kateqoriyalar">Kateqoriyalar</a>
            </nav>
        }
    </main>

    <footer class="staff-foot">
        <a href="/admin/">İdarəetmə paneli</a>
        <span>·</span>
        <a href="/katalog">Müştəri kataloqu</a>
    </footer>
</body>
</html>
