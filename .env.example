# Serverdə bunu `.env` adı ilə kopyalayıb dəyərləri doldur. `.env` COMMIT OLUNMUR.
# Dəyişikliklərdən sonra: docker compose up -d

# ── Məcburi ───────────────────────────────────────────────────────────────────

# Baza parolu. Bir dəfə seçilir; sonradan dəyişmək üçün baza da yenilənməlidir.
POSTGRES_PASSWORD=

# İlk admin — tətbiq açılanda idempotent yaradılır. Parolu ilk girişdən sonra dəyiş.
Bootstrap__AdminEmail=
Bootstrap__AdminPassword=
Bootstrap__CompanyName=
Bootstrap__CompanySlug=

# QR-ın İÇİNƏ düşən ünvan. GERİ DÖNÜŞÜ YOXDUR: etiket çap olunandan sonra bu domen
# dəyişdirilə bilməz, çünki çap olunmuş kodlar köhnə ünvana baxacaq.
# Sonda / OLMAMALIDIR. Nümunə: https://qr.sirket.az
Qr__PublicBaseUrl=

# ── Şəkil saxlama ─────────────────────────────────────────────────────────────
# Local = server diski (uploads volume-unda, backup-a DAXİL DEYİL).
# S3 = Cloudflare R2 (tövsiyə olunur — şəkillər serverdən asılı olmur).
Storage__Provider=Local

# Storage__Provider=S3 olanda:
#Storage__S3__ServiceUrl=https://<account-id>.r2.cloudflarestorage.com
#Storage__S3__AccessKey=
#Storage__S3__SecretKey=
#Storage__S3__Bucket=qrcatalog
#Storage__S3__PublicBaseUrl=https://cdn.sirket.az

# ── İstəyə görə ───────────────────────────────────────────────────────────────

# Müraciət bildirişləri. Verilməsə forma yenə işləyir, sadəcə e-poçt getmir (log-a yazılır).
#Email__Smtp__Host=
#Email__Smtp__Port=587
#Email__Smtp__User=
#Email__Smtp__Password=
#Email__Smtp__From=

# Çox müəssisə olanda /katalog hansını göstərsin (tək müəssisədə lazım deyil).
#Public__DefaultCompanySlug=

# Konteyner portunun host-da bağlandığı ünvan. Caddy başqa maşındadırsa dəyiş,
# amma o zaman portu firewall ilə qoru (bax docker-compose.yml şərhi).
#WEB_BIND=127.0.0.1:8080
